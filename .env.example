# MySQL（宝塔里创建的库）。密码含特殊字符时请做 URL 编码。
DATABASE_URL="mysql://qiyi:change-me@127.0.0.1:3306/qiyi"

# 会话签名。请换成一段足够长的随机字符串，例如：openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string"

# 对外访问地址，仅用于通知正文里的链接
APP_URL="http://127.0.0.1:3847"

# next start 会读取 PORT。宝塔反代到同一端口。
PORT=3847

# 仅在浏览器全程是 HTTPS 时设为 1。反代到本机 HTTP 时保持 0。
COOKIE_SECURE=0

# 可选。OpenAI 兼容接口。留空则只能手动打标签，搭配建议走本地规则。
AI_BASE_URL=""
AI_API_KEY=""
AI_VISION_MODEL=""
AI_TEXT_MODEL=""

# 可选。宝塔计划任务调用 POST /api/cron/daily 时放在请求头 x-cron-secret。
CRON_SECRET=""

# 可选。进程内每天 07:30（Asia/Shanghai）生成提醒。生产环境默认开启，开发环境设 1 才开启。
ENABLE_CRON=""

# 可选。全站 SMTP，用来给打开了邮件提醒的账号发今日搭配。
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# 可选。账号没填 ntfy 地址时的备用主题，例如 https://ntfy.sh/your-topic
NTFY_URL=""
